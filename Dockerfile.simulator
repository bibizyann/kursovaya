# Build the equipment simulator.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o equipment-simulator ./cmd/equipment-simulator

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/equipment-simulator .
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/equipment-simulator"]
